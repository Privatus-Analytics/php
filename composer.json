{
    "name": "privatus/analytics",
    "description": "Adds the cookieless Privatus Analytics tracking script to PHP, Laravel and Symfony/Twig apps. It only prints HTML and never sends data from your server.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "analytics",
        "privacy",
        "cookieless",
        "laravel",
        "symfony",
        "twig",
        "blade",
        "privatus"
    ],
    "homepage": "https://privatusanalytics.com",
    "authors": [
        {
            "name": "Two Phase LLC",
            "homepage": "https://privatusanalytics.com"
        }
    ],
    "support": {
        "issues": "https://github.com/Privatus-Analytics/php/issues",
        "source": "https://github.com/Privatus-Analytics/php",
        "docs": "https://privatusanalytics.com/docs"
    },
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "illuminate/support": "^12.0 || ^13.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0",
        "twig/twig": "^3.0"
    },
    "suggest": {
        "illuminate/support": "For the Laravel service provider, Blade directives and component (Laravel 12 or 13, PHP 8.2 or later).",
        "twig/twig": "For the privatus_analytics(), privatus_event() and privatus_click() Twig functions."
    },
    "autoload": {
        "psr-4": {
            "Privatus\\Analytics\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Privatus\\Analytics\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Privatus\\Analytics\\Laravel\\PrivatusServiceProvider"
            ],
            "aliases": {
                "Privatus": "Privatus\\Analytics\\Laravel\\Facades\\Privatus"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "fix": "php-cs-fixer fix",
        "analyse": "phpstan analyse --memory-limit=512M"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "archive": {
        "exclude": [
            "/vendor",
            "/build",
            "/tests",
            "/example",
            "/.dockerignore",
            "/.github",
            "/Dockerfile",
            "/run-docker.sh",
            "/SUBMISSION.md",
            "/.php-cs-fixer.dist.php",
            "/phpstan.neon.dist",
            "/phpunit.xml.dist",
            "/composer.lock",
            "/.phpunit.cache",
            "/.php-cs-fixer.cache",
            "/.phpunit.result.cache"
        ]
    }
}
